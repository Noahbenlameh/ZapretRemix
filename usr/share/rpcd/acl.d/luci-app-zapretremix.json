{
	"luci-app-zapretremix": {
		"description": "Grant access to ZapretRemix procedures",
		"read": {
			"cgi-io": [ "exec" ],
			"file": {
				"/opt/zapret2/config": [ "read" ],
				"/opt/zapret2/ipset/*": [ "read" ],
				"/tmp/zapret*": [ "read" ],
				"/etc/init.d/zapret2*": [ "exec" ],
				"/etc/init.d/dnsmasq*": [ "exec" ],
				"/bin/busybox*": [ "exec" ],
				"/bin/cat*": [ "exec" ],
				"/usr/sbin/logread*": [ "exec" ],
				"/opt/zapret2/sync_config.sh*": [ "exec" ],
				"/opt/zapret2/update-pkg.sh*": [ "exec" ],
				"/opt/zapret2/blockcheck2.sh*": [ "exec" ],
				"/opt/zapretremix/run-test.sh*": [ "exec" ],
				"/opt/zapretremix/rebuild-opt.sh*": [ "exec" ],
				"/opt/zapretremix/dns-pool.txt": [ "read" ],
				"/opt/zapretremix/pins.json": [ "read" ],
				"/opt/zapretremix/pin-hosts/*": [ "read" ],
				"/opt/zapretremix/pin-blocks.txt": [ "read" ]
			},
			"uci": [ "zapret2", "dhcp", "network" ],
			"ubus": {
				"luci": [ "getInitList", "setInitAction" ]
			}
		},
		"write": {
			"file": {
				"/opt/zapret2/config": [ "write" ],
				"/opt/zapret2/ipset/*": [ "write" ],
				"/opt/zapretremix/dns-pool.txt": [ "write" ],
				"/opt/zapretremix/pins.json": [ "write" ],
				"/opt/zapretremix/pin-hosts/*": [ "write" ],
				"/opt/zapretremix/pin-blocks.txt": [ "write" ]
			},
			"uci": [ "zapret2", "dhcp", "network" ]
		}
	}
}
